<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Two builds of one host:
      net8.0-windows10.0.19041.0  Windows (Windows.Graphics.Capture + Windows OCR)
      net8.0                      macOS and Linux (platform picked at runtime)
    dotnet run -f net8.0-windows10.0.19041.0      on Windows
    dotnet publish -f net8.0 -r osx-arm64          for a Mac
    dotnet publish -f net8.0 -r linux-x64          for Linux
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows10.0.19041.0;net8.0</TargetFrameworks>
    <RootNamespace>MapleLite.Host</RootNamespace>
    <AssemblyName>MapleLite</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Run on a newer .NET when 8 isn't installed (e.g. a Mac with only the .NET 11 SDK). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\MapleLite.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window and taskbar icon on every OS (the .exe icon above is Windows-only). -->
    <AvaloniaResource Include="Assets\MapleLite.ico" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <ProjectReference Include="..\MapleLite.Core\MapleLite.Core.csproj" />
    <ProjectReference Include="..\MapleLite.Sdk\MapleLite.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <ProjectReference Include="..\MapleLite.Platform.Windows\MapleLite.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <ProjectReference Include="..\MapleLite.Platform.Mac\MapleLite.Platform.Mac.csproj" />
    <ProjectReference Include="..\MapleLite.Platform.Linux\MapleLite.Platform.Linux.csproj" />
  </ItemGroup>

  <!-- Shared game data (the item catalog and its icons) ships beside the app as GameData/, for every plugin. -->
  <ItemGroup>
    <None Include="..\MapleLite.Core\GameData\**\*" Exclude="..\MapleLite.Core\GameData\**\desktop.ini"
          LinkBase="GameData" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    Bundled plugins are loaded the same way third-party ones will be: from plugins/<Name>/<Name>.dll,
    each in its own AssemblyLoadContext. The host doesn't reference them; it only builds them first
    and copies their own assembly (Core, Sdk and Avalonia always come from the host).
  -->
  <ItemGroup>
    <BundledPlugin Include="MapleLite.Plugins.ChatHistory;MapleLite.Plugins.Loot;MapleLite.Plugins.SaleCard;MapleLite.Plugins.DpsSimulator;MapleLite.Plugins.XpTracker;MapleLite.Plugins.SpawnTimer;MapleLite.Plugins.Camera;MapleLite.Plugins.PlayerFinder" />
    <ProjectReference Include="@(BundledPlugin->'$(MSBuildThisFileDirectory)..\..\plugins\%(Identity)\%(Identity).csproj')"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <!-- Ask each plugin project where its assembly is, so this works with any output layout. -->
  <Target Name="ResolveBundledPlugins">
    <MSBuild Projects="@(BundledPlugin->'$(MSBuildThisFileDirectory)../../plugins/%(Identity)/%(Identity).csproj')" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_PluginDll" />
    </MSBuild>
    <ItemGroup>
      <_PluginFile Include="@(_PluginDll)" Plugin="%(Filename)" />
      <_PluginFile Include="@(_PluginDll->'%(RootDir)%(Directory)%(Filename).pdb')" Plugin="%(Filename)" />
      <!-- A plugin's Assets folder (catalogs, icons) ships beside its .dll as plugins/<Name>/Assets. -->
      <_PluginAsset Include="$(MSBuildThisFileDirectory)../../plugins/%(BundledPlugin.Identity)/Assets/**/*" Exclude="$(MSBuildThisFileDirectory)../../plugins/%(BundledPlugin.Identity)/Assets/**/desktop.ini" Plugin="%(BundledPlugin.Identity)" />
    </ItemGroup>
  </Target>
  <!-- Inner (per-framework) builds only: the outer multi-target build has no OutDir and would copy into the source tree. -->
  <Target Name="CopyBundledPlugins" AfterTargets="Build" DependsOnTargets="ResolveBundledPlugins" Condition="'$(TargetFramework)' != ''">
    <Copy SourceFiles="@(_PluginFile)" DestinationFolder="$(OutDir)plugins\%(_PluginFile.Plugin)" SkipUnchangedFiles="true" Condition="Exists('%(_PluginFile.FullPath)')" />
    <Copy SourceFiles="@(_PluginAsset)" DestinationFiles="@(_PluginAsset->'$(OutDir)plugins\%(Plugin)\Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- dotnet publish: put the plugins beside the published app too. -->
  <Target Name="PublishBundledPlugins" AfterTargets="Publish" DependsOnTargets="ResolveBundledPlugins" Condition="'$(TargetFramework)' != ''">
    <Copy SourceFiles="@(_PluginFile)" DestinationFolder="$(PublishDir)plugins\%(_PluginFile.Plugin)" SkipUnchangedFiles="true" Condition="Exists('%(_PluginFile.FullPath)')" />
    <Copy SourceFiles="@(_PluginAsset)" DestinationFiles="@(_PluginAsset->'$(PublishDir)plugins\%(Plugin)\Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
