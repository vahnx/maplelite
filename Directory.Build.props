<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AvaloniaVersion>11.3.21</AvaloniaVersion>
    <!-- DataGrid is versioned on its own; 11.3.13 is its newest 11.x and works with Avalonia 11.3.x. -->
    <AvaloniaDataGridVersion>11.3.13</AvaloniaDataGridVersion>
    <Company>CheesyFrog Technologies</Company>
    <Product>MapleLite</Product>
    <Version>0.1.0-alpha</Version>
    <!-- Lets macOS and Linux restore and build the whole solution, Windows projects included. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <!--
    Build output (bin/obj) goes outside the source folder: this folder is synced by Google Drive, which
    locks freshly written build files and breaks builds. On Windows it goes to
    %LOCALAPPDATA%/MapleLite-build/<checkout folder> (MapleLite-build/MapleLite for the main checkout), so each copy of
    the repo (a git worktree, a second clone) has its own: two copies sharing one folder overwrite each other's DLLs and
    the app fails to start with "Method not found". Elsewhere it goes to ./artifacts (gitignored). Override with
    -p:ArtifactsPath=...
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!-- Multiple project-reference builds can otherwise race over shared artifacts in LocalAppData. -->
    <BuildInParallel>false</BuildInParallel>
    <_MapleLiteCheckout>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildThisFileDirectory)))))</_MapleLiteCheckout>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == '' and '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)/MapleLite-build/$(_MapleLiteCheckout)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
